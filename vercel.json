{
  "version": 2,
  "functions": {
    "api/*.js": {
      "runtime": "@vercel/node@5.5.11"
    }
  },
  "rewrites": [
    {
      "source": "/api/tv-upload",
      "destination": "https://club-pop-api.renato-vilelas-personal.workers.dev/tv/upload"
    },
    {
      "source": "/api/tv-campaigns",
      "destination": "https://club-pop-api.renato-vilelas-personal.workers.dev/tv/campaigns"
    },
    {
      "source": "/api/tv-media",
      "destination": "https://club-pop-api.renato-vilelas-personal.workers.dev/tv/media"
    },
    {
      "source": "/api/links-uteis/:action",
      "destination": "/api/evo-config?route=links-uteis&action=:action"
    },
    {
      "source": "/l/:slug",
      "destination": "/api/evo-config?route=links-uteis&action=redirect&slug=:slug"
    },
    {
      "source": "/aula-experimental",
      "destination": "/aula-experimental/index.html"
    },
    {
      "source": "/aula-experimental/",
      "destination": "/aula-experimental/index.html"
    },
    {
      "source": "/api/community-challenges",
      "destination": "https://club-pop-api.renato-vilelas-personal.workers.dev/member/community-challenges"
    },
    {
      "source": "/api/partner-daily-redemption",
      "destination": "https://club-pop-api.renato-vilelas-personal.workers.dev/partner-daily-redemption"
    },
    {
      "source": "/checkout/service-voucher",

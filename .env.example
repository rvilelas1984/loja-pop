# Bike Pop: DNS, token e validade são cadastrados no ADM e armazenados no D1.
# Não configurar EVO_DNS/EVO_TOKEN para novas instalações.
# Secrets legados existentes só devem ser removidos após homologação completa.
GYM_EVO_DNS=configure_no_ambiente_seguro
GYM_EVO_TOKEN=configure_no_ambiente_seguro
# ADMIN_KEY existente também assina a comunicação interna Vercel → Worker.
ADMIN_KEY=configure_no_ambiente_seguro
